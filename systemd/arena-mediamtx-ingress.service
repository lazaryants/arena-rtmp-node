[Unit]
Description=Arena76 legacy RTMP URL compatibility ingress
Documentation=https://mediamtx.org/
Wants=network-online.target
After=network-online.target mediamtx.service arena-rtmp-auth.service
Requires=mediamtx.service arena-rtmp-auth.service

[Service]
Type=simple
User=mediamtx
Group=mediamtx
WorkingDirectory=/var/lib/mediamtx
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/ingress.yml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
