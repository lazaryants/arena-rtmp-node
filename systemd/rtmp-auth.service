[Unit]
Description=RTMP Auth Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cricket-rtmp-node
Environment="CRICKET_RTMP_ROOT=/opt/cricket-rtmp-node"
EnvironmentFile=-/opt/cricket-rtmp-node/config/node.env
ExecStart=/opt/cricket-rtmp-node/.venv/bin/python -m app.rtmp_auth
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
