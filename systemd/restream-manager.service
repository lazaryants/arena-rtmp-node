[Unit]
Description=Cricket Restream Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cricket-rtmp-node
Environment="PATH=/opt/cricket-rtmp-node/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="CRICKET_RTMP_ROOT=/opt/cricket-rtmp-node"
EnvironmentFile=-/opt/cricket-rtmp-node/config/node.env
ExecStart=/opt/cricket-rtmp-node/.venv/bin/python -m app.restream_manager
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
