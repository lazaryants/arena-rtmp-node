[Unit]
Description=Cricket Restream Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/restream-app
Environment="PATH=/opt/restream-env/bin"
Environment="CRICKET_RTMP_APP_DIR=/opt/restream-app"
Environment="CRICKET_RTMP_CONFIG=/opt/restream-config.json"
Environment="CRICKET_RTMP_PUBLIC_HOST=video.curling76.ru"
Environment="CRICKET_RTMP_HLS_ROOT=/var/www/hls"
ExecStart=/opt/restream-env/bin/python /opt/restream_manager.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
