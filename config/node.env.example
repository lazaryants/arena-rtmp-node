# Copy to /opt/arena-rtmp-node/config/node.env and adjust as needed.
ARENA_RTMP_ROOT=/opt/arena-rtmp-node
ARENA_RTMP_PUBLIC_HOST=rtmp.arena76.top
ARENA_RTMP_HLS_ROOT=/var/www/hls
ARENA_RTMP_LOCAL_HLS_ORIGIN=http://127.0.0.1/hls
ARENA_RTMP_LOCAL_RTMP_ORIGIN=rtmp://127.0.0.1
ARENA_RTMP_STAT_URL=http://127.0.0.1:8090/stat
ARENA_RTMP_FFMPEG=/usr/bin/ffmpeg
ARENA_RTMP_MANAGER_BIND=127.0.0.1:5000
ARENA_RTMP_AUTH_BIND=127.0.0.1:8080
ARENA_RTMP_MANAGER_THREADS=4
ARENA_RTMP_MANAGER_TIMEOUT=30
ARENA_RTMP_LOG_LEVEL=info

# Optional overrides. Defaults already point inside ARENA_RTMP_ROOT.
# ARENA_RTMP_CONFIG=/opt/arena-rtmp-node/state/restream-config.json
# ARENA_RTMP_RUN_DIR=/opt/arena-rtmp-node/run
# ARENA_RTMP_LOG_DIR=/opt/arena-rtmp-node/logs
# ARENA_RTMP_SUPERVISOR_SOCKET=/opt/arena-rtmp-node/run/supervisor.sock
